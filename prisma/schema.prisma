// Jevotequi political data schema.
//
// The database is a read model rebuilt from the YAML files (ADR 0003). The
// seed script is its only writer, and it is idempotent. Nothing writes
// political data at runtime.
//
// Guideline §27 lists three invariants. Two of them are not expressible here:
//   - "a position has at least one source" needs a deferred trigger, added in
//     migrations/0002_constraints.sql, and is already enforced in CI by the
//     file validator.
//   - "no table stores user answers" is not a constraint at all. It is a
//     schema review rule (§50) and a test (src/http/privacy.test.ts).
// The third — non-overlapping validity ranges — is a real EXCLUDE constraint,
// also in 0002_constraints.sql, because Prisma cannot express it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Election {
  id                 String   @id
  slug               String   @unique
  name               String
  country            String   @db.Char(2)
  electionType       String   @map("election_type")
  electionDate       DateTime @map("election_date") @db.Date
  status             String
  fictional          Boolean  @default(false)
  // §9: the inclusion criterion is published with the election.
  inclusionRule      String   @map("inclusion_rule")
  inclusionDecidedOn DateTime @map("inclusion_decided_on") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  themes     Theme[]
  candidates Candidate[]

  @@map("election")
}

model Theme {
  id           String  @id
  electionId   String  @map("election_id")
  name         String
  description  String
  displayOrder Int     @map("display_order")
  active       Boolean @default(true)

  election  Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([electionId, displayOrder])
  @@map("theme")
}

model Question {
  id           String  @id
  themeId      String  @map("theme_id")
  text         String
  displayOrder Int     @map("display_order")
  active       Boolean @default(true)
  // §12: the neutrality review travels with the question, so the methodology
  // page can be generated from the data rather than maintained beside it.
  reviewedBy   String  @map("reviewed_by")
  reviewedOn   DateTime @map("reviewed_on") @db.Date
  publicReviewMr Int?  @map("public_review_mr")

  theme     Theme               @relation(fields: [themeId], references: [id], onDelete: Cascade)
  positions CandidatePosition[]

  @@unique([themeId, displayOrder])
  @@map("question")
}

model PoliticalGroup {
  id   String @id
  name String

  candidates Candidate[]

  @@map("political_group")
}

model Candidate {
  id     String @id
  electionId String @map("election_id")
  displayName String @map("display_name")
  // §24: lowercased, diacritics stripped, so ordering never depends on the
  // runtime's locale data.
  normalizedName String @map("normalized_name")
  politicalGroupId String? @map("political_group_id")
  // §9: the order published by the authority. Unique, otherwise the default
  // order is not total and would fall back to insertion order.
  officialOrder Int? @map("official_order")
  inclusionStatus String @map("inclusion_status")

  election       Election        @relation(fields: [electionId], references: [id], onDelete: Cascade)
  politicalGroup PoliticalGroup? @relation(fields: [politicalGroupId], references: [id])
  programs       Program[]
  positions      CandidatePosition[]

  @@unique([electionId, normalizedName])
  @@unique([electionId, officialOrder])
  @@map("candidate")
}

model Program {
  id          String @id
  candidateId String @map("candidate_id")
  title       String

  candidate Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  versions  ProgramVersion[]

  @@map("program")
}

model ProgramVersion {
  id          String   @id
  programId   String   @map("program_id")
  title       String
  publishedAt DateTime @map("published_at") @db.Date

  program   Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  positions CandidatePosition[]

  @@map("program_version")
}

model Source {
  id              String   @id
  title           String
  url             String
  sourceType      String   @map("source_type")
  publishedAt     DateTime @map("published_at") @db.Date
  retrievedAt     DateTime @map("retrieved_at") @db.Date
  // §19: hash of the normalized extracted text, never of the raw file.
  contentHash     String   @map("content_hash") @db.Char(64)
  // §17: campaign material disappears; a published position stays verifiable.
  archivedCopyUrl String   @map("archived_copy_url")

  positionSources CandidatePositionSource[]

  @@map("source")
}

model CandidatePosition {
  id               String    @id
  candidateId      String    @map("candidate_id")
  questionId       String    @map("question_id")
  // §13: value on the scale -2..+2.
  position         Int
  // §42: only `confirmed` is scored.
  status           String
  // §14: the passage that justifies the value.
  quote            String
  note             String?
  programVersionId String    @map("program_version_id")
  codedBy          String    @map("coded_by")
  codedAt          DateTime  @map("coded_at") @db.Date
  // §14 degraded mode: null until a second pass. A confirmed position with a
  // null reviewer is rejected by the file validator before it reaches here.
  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at") @db.Date
  // §20: half-open interval. validUntil is exclusive; null means in force.
  validFrom        DateTime  @map("valid_from") @db.Date
  validUntil       DateTime? @map("valid_until") @db.Date

  candidate      Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  question       Question                  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  programVersion ProgramVersion            @relation(fields: [programVersionId], references: [id])
  sources        CandidatePositionSource[]

  @@index([candidateId, questionId])
  @@map("candidate_position")
}

// §16: sources are attached through a join table. A position may be supported
// by more than one source, and one source supports many positions.
model CandidatePositionSource {
  candidatePositionId String  @map("candidate_position_id")
  sourceId            String  @map("source_id")
  locator             String?

  position CandidatePosition @relation(fields: [candidatePositionId], references: [id], onDelete: Cascade)
  source   Source            @relation(fields: [sourceId], references: [id])

  @@id([candidatePositionId, sourceId])
  @@map("candidate_position_source")
}

// Deliberately absent: any table holding user answers, theme weights supplied
// by a user, or a computed result. See §32. Adding one is a schema review
// failure, not a migration.
